# ---------- Frontend (safe to expose: anon key is public by design, protected by RLS) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=http://localhost:5173

# ---------- Server only: Supabase Edge Function secrets (set with `supabase secrets set`) ----------
# NEVER prefix these with VITE_ and NEVER commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Online payment (fill only after the merchant account is approved) ----------
PAYMENT_PROVIDER=paymob
PAYMENT_MODE=sandbox
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
